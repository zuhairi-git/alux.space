{
  "name": "alux.space",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/seo-build.js",
    "postbuild": "node -e \"const fs = require('fs'); fs.rmSync('out/cache', { recursive: true, force: true });\"" ,
    "build:clean": "Remove-Item -Recurse -Force .next-prod -ErrorAction SilentlyContinue; echo done",
    "clean:out-cache": "node -e \"const fs = require('fs'); fs.rmSync('out/cache', { recursive: true, force: true });\"",
    "start": "next start",
    "lint": "next lint",
    "seo:audit": "node scripts/seo-dev.js audit",
    "seo:monitor": "node scripts/seo-dev.js monitor",
    "seo:watch": "node scripts/seo-dev.js watch",
    "sitemap": "node -e \"require('./seo/sitemap.ts').generateSitemap()\"",
    "build:isolated": "node scripts/build-isolated.js",
    "precommit": "npm run lint && npm run seo:audit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@types/file-saver": "^2.0.7",
    "@vercel/og": "^0.6.8",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.7.3",
    "gtag": "^1.0.1",
    "jspdf": "^4.0.0",
    "next": "15.3.0",
    "next-intl": "^4.1.0",
    "next-share": "^0.27.0",
    "node-fetch": "^3.3.2",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unsplash-js": "^7.0.19",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "postcss": "^8.5.3",
    "puppeteer": "^23.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5"
  }
}
