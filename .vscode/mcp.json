{
  "inputs": [
    {
      "id": "figma-api-key",
      "type": "promptString",
      "description": "Figma Personal Access Token",
      "password": true
    }
  ],
  "servers": {
    "figma": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "figma-developer-mcp@0.6.4",
        "--figma-api-key=${input:figma-api-key}",
        "--stdio"
      ]
    }
  }
}
